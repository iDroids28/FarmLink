MONGO_URI=
PORT=5000
# Long random string used to sign session (JWT) tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Frontend origin(s), comma-separated. Vite in this project runs on 3000.
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173
NODE_ENV=development
# Set to 1 when deployed behind a reverse proxy / load balancer
TRUST_PROXY=
# REQUIRED for signup, resend, and forgot-password OTP email delivery.
# Gmail SMTP uses STARTTLS on port 587. There is no terminal OTP fallback.
# Gmail is the sender account; recipients may use other domains (e.g. phinmaed.com).
# SMTP_PASS must be a Google App Password, NOT your normal Gmail password.
# Keep real credentials in your local .env only; never commit .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-group-gmail@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="FarmLink <your-group-gmail@gmail.com>"