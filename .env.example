MONGO_URI=
PORT=5000
# Long random string used to sign session (JWT) tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Frontend origin(s), comma-separated. Vite in this project runs on 3000.
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173
NODE_ENV=development
# Set to 1 when deployed behind a reverse proxy / load balancer
TRUST_PROXY=
# Optional: real OTP emails. Without SMTP the OTP prints in the dev terminal only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=